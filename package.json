{
  "name": "alveo-closet-configurator",
  "version": "0.1.0",
  "description": "Custom closet layouts designed around your wardrobe, your life, your space",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "check:bundle": "tsx scripts/bundle-budget.ts"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.0",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "closet",
    "configurator",
    "interior-design",
    "storage",
    "wardrobe",
    "layout-generator"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
